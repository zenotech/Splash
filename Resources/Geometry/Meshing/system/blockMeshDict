(
    (-2 -2 -1)  // vertex 0
    ( 8 -2 -1)  // vertex 1
    ( 8  2 -1)  // vertex 2
    (-2  2 -1)  // vertex 3
    (-2 -2  1)  // vertex 4
    ( 8 -2  1)  // vertex 5
    ( 8  2  1)  // vertex 6
